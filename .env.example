# =============================================================================
# Bookora - Multi-Tenant Booking SaaS
# Production Environment Configuration
# =============================================================================
# Copy this file to .env (or .env.local) and fill in your production values:
#   cp .env.example .env
#
# [REQUIRED]  = Must be set for the application to function
# [CRITICAL]  = Security-critical, protect like a password
# [OPTIONAL]  = Can be left blank for default behavior
# =============================================================================

# ──────────────────────────────────────────────────────────────────────────────
#  DATABASE - Neon PostgreSQL / Supabase
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:password@ep-example-123.us-east-2.aws.neon.tech/bookora?sslmode=require"

# [REQUIRED for migrations] Direct DB connection (bypasses pooler).
DIRECT_URL="postgresql://postgres:password@ep-example-123.us-east-2.aws.neon.tech/bookora?sslmode=require"

# ──────────────────────────────────────────────────────────────────────────────
#  AUTHENTICATION - NextAuth.js v5
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] [CRITICAL] Secret to encrypt session cookies & JWTs.
# Generate: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# [REQUIRED] Canonical URL of your deployment (no trailing slash).
NEXTAUTH_URL="https://yourdomain.com"

# [OPTIONAL] Public-facing URL.
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ──────────────────────────────────────────────────────────────────────────────
#  ENCRYPTION - OAuth tokens, API keys at rest
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] [CRITICAL] Encryption key for sensitive data at rest.
# Generate: openssl rand -base64 32
ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"

# ──────────────────────────────────────────────────────────────────────────────
#  STRIPE - Payments
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Stripe Secret Key. sk_live_ (prod) or sk_test_ (dev).
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"

# [REQUIRED] [CRITICAL] Stripe Webhook Secret.
# https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# [OPTIONAL] Stripe Publishable Key (client-side).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your_stripe_publishable_key"

# ──────────────────────────────────────────────────────────────────────────────
#  RESEND - Transactional Email
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Resend API Key. https://resend.com/api-keys
RESEND_API_KEY="re_your_resend_api_key"

# [REQUIRED] Verified sender address for outgoing emails.
EMAIL_FROM="Bookora <notifications@yourdomain.com>"

# ──────────────────────────────────────────────────────────────────────────────
#  GOOGLE OAUTH - Login & Google Calendar
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED for Google features] OAuth Client ID.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# [REQUIRED for Google features] OAuth Client Secret.
GOOGLE_CLIENT_SECRET="your-client-secret"

# ──────────────────────────────────────────────────────────────────────────────
#  SENTRY - Error Monitoring
# ──────────────────────────────────────────────────────────────────────────────

# [REQUIRED for monitoring] Sentry DSN.
# https://sentry.io/settings/projects/YOUR_PROJECT/keys/
NEXT_PUBLIC_SENTRY_DSN="https://your-dsn@sentry.io/your-project-id"
SENTRY_DSN="https://your-dsn@sentry.io/your-project-id"

# Sentry auth token (for source map uploads).
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# Sentry organization and project slugs.
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="bookora"

# ──────────────────────────────────────────────────────────────────────────────
#  CRON JOBS - Vercel Cron Jobs
# ──────────────────────────────────────────────────────────────────────────────

# [RECOMMENDED] [CRITICAL] Secret to authenticate cron job invocations.
# Used as Bearer token. Generate: openssl rand -base64 32
CRON_SECRET="generate-with-openssl-rand-base64-32"

# ──────────────────────────────────────────────────────────────────────────────
#  CSRF & EMBED PROTECTION
# ──────────────────────────────────────────────────────────────────────────────

# [OPTIONAL] Additional allowed origins for CSRF (comma-separated).
CSRF_ALLOWED_ORIGINS=""

# [OPTIONAL] Origins allowed to embed booking widget (comma-separated).
EMBED_ALLOWED_ORIGINS=""
